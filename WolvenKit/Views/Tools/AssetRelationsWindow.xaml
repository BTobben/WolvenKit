<mah:MetroWindow x:Class="WolvenKit.Views.Tools.AssetRelationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:models="clr-namespace:WolvenKit.App.Models.AssetRelations;assembly=WolvenKit.App"
    Title="Asset relationships" Width="1100" Height="740" MinWidth="650" MinHeight="400"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Asset relationships" FontSize="22" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                Text="Expand Uses to follow dependencies, or Used by to trace references back. Each branch preserves its parent chain." />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.75"
                Text="Uses reads file imports; targets follow WolvenKit's project/mod/game resolution. Used by queries the Resources index by path hash, may be outdated, and does not prove which override is used. Dynamic links and unsaved edits are not included." />
        </StackPanel>
        <TreeView x:Name="RelationTree" Grid.Row="1" SelectedItemChanged="OnSelectionChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type models:AssetRelationNode}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Details}" />
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <EventSetter Event="Expanded" Handler="OnExpanded" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <TextBox x:Name="DetailsBox" Grid.Row="2" Margin="0,10,0,10" MinHeight="65"
            IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" />
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Select an asset to inspect its path and archive." />
            <Button x:Name="OpenButton" HorizontalAlignment="Right" Content="Open selected asset"
                Click="OnOpenClick" IsEnabled="False" Padding="12,6" />
        </DockPanel>
    </Grid>
</mah:MetroWindow>
